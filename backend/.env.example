# Local deterministic mode. Does not use network providers.
APP_MODE=demo

# Live mode requires both provider keys and an explicitly selected model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TAVILY_API_KEY=

# Local SQLite file; generated database files are ignored by Git.
DATABASE_PATH=data/research.sqlite3
MAX_ACTIVE_RUNS=2
MAX_DOCUMENT_CHARS=18000
MAX_PDF_PAGES=30
MAX_FETCH_BYTES=5000000
MODEL_MAX_OUTPUT_TOKENS=1200
